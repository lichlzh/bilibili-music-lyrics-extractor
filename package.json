{
  "name": "bilibili-mp3-downloader",
  "version": "0.0.4",
  "description": "B站视频下载并转为 MP3 的跨平台桌面应用（仅供个人学习/欣赏）",
  "author": "lz",
  "license": "MIT",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/fix-electron.cjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder --publish never"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "electron-store": "^8.2.0",
    "iconv-lite": "^0.7.3",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0",
    "tailwind-merge": "^2.5.5",
    "yt-dlp-wrap": "^2.3.12"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.47",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.lz.bilimp3",
    "productName": "B站音乐下载器",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": true,
    "asarUnpack": [
      "**/node_modules/@ffmpeg-installer/**"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.music",
      "identity": null
    },
    "win": {
      "target": "nsis",
      "signing": {
        "timestampServer": "http://timestamp.digicert.com"
      }
    },
    "nsis": {
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "lichlzh",
      "repo": "bilibili-music-lyrics-extractor"
    }
  }
}
